    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "//overrides": "Security/compat pins for transitive deps until upstream ships the fix; re-review on each dep bump (Dependabot). 'ws ^8.21.0' patches the ws DoS GHSA-96hv-2xvq-fx4p pulled by viem's isows; the nested @walletconnect/jsonrpc-ws-connection keeps its own non-vulnerable ws@7 so WalletConnect is untouched.",
  "overrides": {
    "ws": "^8.21.0",
    "@walletconnect/jsonrpc-ws-connection": {
      "ws": "^7.5.1"
    }
  }
