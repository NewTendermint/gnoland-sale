    "@echoxyz/sonar-core": "0.15.0",
    "@netlify/database": "^1.1.0",
    "@tanstack/react-query": "^5.101.0",
    "@walletconnect/ethereum-provider": "^2.23.9",
    "drizzle-orm": "1.0.0-beta.22",
    "gsap": "^3.15.0",
    "iron-session": "^8.0.4",
    "libsodium-wrappers": "^0.8.4",
    "markdown-to-jsx": "^9.8.2",
    "next": "15.5.18",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "viem": "^2.52.2",
