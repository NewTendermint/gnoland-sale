# =============================================================================
# Public - inlined into the client bundle at build. NEVER put a secret here.
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sale chain (CLIENT). Pairs with SALE_CHAIN (server, below) - always set BOTH to the same value:
# local + staging = sepolia, prod = mainnet. Unset falls back to sepolia, never mainnet; any other
# value throws at module scope, so a typo fails the build (lib/sale/contracts.ts).
NEXT_PUBLIC_SALE_CHAIN=sepolia
# Sepolia SettlementSale address override (Sonar sandbox). A sale redeploy changes the contract, so
# set this to the Contract Address on Echo's Integration page. Unset = the built-in default.
# NEXT_PUBLIC_SEPOLIA_SETTLEMENT_SALE=

# Dedicated RPC per chain. Unset = viem's public default (rate-limited, not launch-grade). When you
# set one, add its host to the CSP connect-src in middleware.ts.
# FOOTGUN: NEXT_PUBLIC_ inlines this into every visitor's bundle, and Alchemy/Infura put the API key
# in the URL path. Use a keyless endpoint, or one whose key is domain-restricted.
NEXT_PUBLIC_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Milestone overrides (ISO). Unset = the confirmed dates in lib/sale/economics.ts. Override these
# (e.g. on the staging branch-deploy) to place a deploy in a given phase - the phase is derived
# purely from these dates, there is no phase-override flag.
# NEXT_PUBLIC_REGISTRATION_OPENS=
# NEXT_PUBLIC_SALE_OPENS=
# NEXT_PUBLIC_SALE_CLOSES=

# Commitment minimum override (sandbox/staging only). Prod default is 100; set to the sandbox sale
# min (e.g. 2) on preview/branch deploys. Leave unset in production.
# NEXT_PUBLIC_MIN_COMMITMENT_USD=2

# Newsletter capture UI gate ("1" required in production builds; dev defaults on).
NEXT_PUBLIC_NEWSLETTER_ENABLED=

# Tiered contribution-bonus UI gate ("1" required in production builds; dev defaults on). Reader:
# tieredBonusEnabled() in lib/sale/bonus.ts. Display-only; the bonus is granted off-app.
NEXT_PUBLIC_TIERED_BONUS=

# /dev/states gallery (mock fixtures). Always on in local dev; deployed contexts need this flag,
# set for branch-deploy only, so the page 404s in production (lib/sale/overrides.ts).
# NEXT_PUBLIC_DEV_STATES_ENABLED=

# WalletConnect / Reown project id (PUBLIC, not a secret). A default is built in
# (app/[locale]/(layout)/web3.ts); override per environment. Lock usage to our domains via Reown
# AllowList, not by hiding the id.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# =============================================================================
# Server-only - NEVER prefix with NEXT_PUBLIC
# =============================================================================
# Sale chain (SERVER). Pairs with NEXT_PUBLIC_SALE_CHAIN above - keep them identical. Drives the
# audit chain_id + server-side chain branching. local/staging = sepolia, prod = mainnet.
SALE_CHAIN=sepolia
SALE_PAUSED=false

# Sonar (Echo). SONAR_MOCK=1 serves local fixtures instead of the real API (dev only). The others
# come from Echo's sale Integration page (Client ID, Sale UUID, API base) + your OAuth callback URL.
SONAR_MOCK=
SONAR_CLIENT_UUID=
SONAR_SALE_UUID=
SONAR_API_BASE_URL=
SONAR_REDIRECT_URI=

# Secrets - GENERATE, don't look up. ENCRYPTION_KEY / IP_HMAC_PEPPER = `openssl rand -hex 32` (64 hex);
# SESSION_PASSWORD = 32+ chars. Prod keys must be unique and NEVER shared with test.
# (ENCRYPTION_KEY rotates every 6 months, IP_HMAC_PEPPER every 3 - spec 4.7.)
ENCRYPTION_KEY=
IP_HMAC_PEPPER=
SESSION_PASSWORD=
# Netlify Database (GA). In Netlify builds/functions/edge, NETLIFY_DB_URL is injected
# automatically and the app connects through the drizzle-orm/netlify-db adapter
# (lib/db/client.ts) - nothing to set here for production/preview, and the deploy applies
# migrations from netlify/database/migrations on its own. For LOCAL dev (no Netlify CLI),
# point a Postgres you control here so both the app runtime and drizzle-kit can reach it:
NETLIFY_DB_URL=
# Optional override, read only by drizzle-kit migrate/studio (falls back to NETLIFY_DB_URL):
# DATABASE_URL=

# Newsletter (Mailchimp) credentials. MAILCHIMP_MOCK=1 is the ONLY way to mock (explicit opt-in,
# same contract as SONAR_MOCK); a missing key without it fails closed as upstream-error.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_MOCK=
# Sender identity on the price-alert campaign (lib/newsletter/campaign.ts). Optional at boot.
# MAILCHIMP_FROM_NAME=
# MAILCHIMP_REPLY_TO=
# Price-alert sends require exactly "1"; any other value dry-runs. The cron runs either way.
# EMAIL_ALERTS_ENABLED=

# Web Push (VAPID). Generate: npx web-push generate-vapid-keys --json. The private key is server-only;
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY (intentionally client-exposed). Absent = push off.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:notifications@gno.land
# Bearer for all four scheduled routes (lib/security/cron-auth.ts): push/email cron, db cleanup,
# attribution reconcile. Unset = the cron feature is off. openssl rand -hex 32
# CRON_SECRET=

# Fan-out targets for the scheduled functions (netlify/cron-fan-out.mts): only the production deploy
# is scheduled, so that one run pokes both legs.
# FOOTGUN: the fan-out sends `Bearer CRON_SECRET` to whatever host these name, and a failing staging
# leg is only logged. A stale or mistyped hostname hands the secret to its owner, quietly.
# CRON_PROD_URL falls back to URL then NEXT_PUBLIC_SITE_URL, and throws if none resolves; only the
# staging leg is skipped when unset.
# CRON_PROD_URL=
# CRON_STAGING_URL=

# Dev tooling only (scripts/probe-sale.mjs - read-only on-chain sale probe).
# SALE_ADDRESS=
# SALE_RPCS=
