# Public (safe in client bundle)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SALE_PHASE=pre

# Server-only — NEVER prefix with NEXT_PUBLIC
SONAR_CLIENT_UUID=
SONAR_REDIRECT_URI=
SONAR_SALE_UUID=
SONAR_API_BASE_URL=
# 32-byte hex (libsodium secretbox / XSalsa20-Poly1305 key). Rotates every 6 months per spec §4.7
ENCRYPTION_KEY=
# 32-byte hex (HMAC-SHA256 of IPs). Rotates every 3 months per spec §4.7
IP_HMAC_PEPPER=
# 32+ char string for iron-session cookie encryption
SESSION_PASSWORD=
SALE_PAUSED=false
# Target chain: "base" (mainnet, prod) or "base-sepolia" (preview/testnet).
# Drives the audit chain_id and server-side chain branching. Defaults to testnet.
SALE_CHAIN=base-sepolia
DATABASE_URL=
NETLIFY_BLOBS_TOKEN=
