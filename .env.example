# Public (safe in client bundle)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Phase OVERRIDE (optional escape hatch): "pre-sale" | "live" | "ended". Commented = unset = the
# phase follows the sale clock (the 3 dates in lib/sale/economics.ts). Uncomment only for staging or
# to force a phase during an incident.
# NEXT_PUBLIC_SALE_PHASE=
# Milestone overrides (ISO). Unset = the confirmed dates in lib/sale/economics.ts.
# NEXT_PUBLIC_REGISTRATION_OPENS=
# NEXT_PUBLIC_SALE_OPENS=
# NEXT_PUBLIC_SALE_CLOSES=
# "1" keeps the ?phase/?registration/?journey overrides + /dev/states usable in a
# production BUILD (dev is always on). Set by netlify.toml while the site is a
# staging preview; must be gone from the production context at launch.
# NEXT_PUBLIC_STATE_OVERRIDES=
# WalletConnect / Reown project id (PUBLIC, not a secret). A default is built in
# (app/(layout)/web3.ts); override per environment. Lock usage to our domains via
# the Reown AllowList, not by hiding the id.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only - NEVER prefix with NEXT_PUBLIC
# Dev-only: "1" serves Sonar fixtures instead of the real API (lib/sonar/mock-config.ts)
SONAR_MOCK=
SONAR_CLIENT_UUID=
SONAR_REDIRECT_URI=
SONAR_SALE_UUID=
SONAR_API_BASE_URL=
# 32-byte hex (libsodium secretbox / XSalsa20-Poly1305 key). Rotates every 6 months per spec §4.7
ENCRYPTION_KEY=
# 32-byte hex (HMAC-SHA256 of IPs). Rotates every 3 months per spec §4.7
IP_HMAC_PEPPER=
# 32+ char string for iron-session cookie encryption
SESSION_PASSWORD=
SALE_PAUSED=false
# Target chain: "mainnet" (Ethereum mainnet, prod) or "sepolia" (preview/testnet).
# Drives the audit chain_id and server-side chain branching. Defaults to testnet.
SALE_CHAIN=sepolia
# Postgres (Neon). On Netlify with the Database add-on this is injected as
# NETLIFY_DATABASE_URL and aliased automatically (lib/env.ts); set DATABASE_URL for local dev.
DATABASE_URL=

# Newsletter (Mailchimp). The capture UI is gated by NEXT_PUBLIC_NEWSLETTER_ENABLED
# ("1" required in production; dev defaults on). Credentials are server-only.
NEXT_PUBLIC_NEWSLETTER_ENABLED=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Dev-only: "1" forces the Mailchimp mock (auto-on in dev while no API key is set)
MAILCHIMP_MOCK=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys --json
# Private key is server-only; set NEXT_PUBLIC_VAPID_PUBLIC_KEY to the SAME value as VAPID_PUBLIC_KEY.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:notifications@gno.land
# CRON_SECRET=  # bearer secret for the scheduled outbid-cron route (openssl rand -hex 32)

# Dev tooling only (scripts/probe-sale.mjs - read-only on-chain sale probe)
# SALE_ADDRESS=
# SALE_RPCS=
